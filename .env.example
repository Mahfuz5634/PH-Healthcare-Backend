NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://username:password@localhost:5432/ph_healthcare?schema=public"

JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your_google_client_id_here

# Seed Credentials
SUPER_ADMIN_EMAIL=superadmin@gmail.com
SUPER_ADMIN_PASSWORD=your_super_admin_secure_password
TESTER_ADMIN_EMAIL=admin@gmail.com
TESTER_ADMIN_PASSWORD=your_tester_admin_password
TESTER_DOCTOR_EMAIL=doctor@gmail.com
TESTER_DOCTOR_PASSWORD=your_tester_doctor_password

# Redis Configuration
REDIS_USER=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP Configuration
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
